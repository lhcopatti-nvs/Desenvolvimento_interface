                );


                linkEtica.textContent =
                    'Código de Ética Discente do CEUB';

                const divEtica =
                    document.createElement('div');

                divEtica.className = 'my-3';

                divEtica.appendChild(
                    linkEtica
                );

                wrapper.appendChild(
                    divEtica
                );
            }


            node.parentNode.replaceChild(
                wrapper,
                node
            );

            console.log(
                'Parte II e Código de Ética reconstruídos com sucesso.'
            );

            break;
        }
    }


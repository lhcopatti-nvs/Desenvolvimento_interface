function imprimirDiv() {
    var pai = document.getElementById("page-mod-lesson-view");
    if (!pai) {
        alert("Conteúdo não encontrado.");
        return;
    }

    // Lista das possíveis classes filhas que podem existir na página
    var classesFilhas = [".planoensino_gv1", ".planoensino_gv2", ".planoensino_pos","#planoensinoinfodisciplina"];

    var conteudoParaImprimir = '';

    // Procura qual classe filha existe dentro do pai (para essa página)
    for (var i = 0; i < classesFilhas.length; i++) {
        var el = pai.querySelector( classesFilhas[i]);
        if (el) {
            conteudoParaImprimir = '<div id="page-mod-lesson-view"><div class="' + classesFilhas[i] + '">' + el.innerHTML + '</div></div>';
            break; // achou uma, sai do loop
        }
    }

    if (!conteudoParaImprimir) {
        alert("Nenhum conteúdo para imprimir encontrado.");
        return;
    }

    criarIframeEImprimir(conteudoParaImprimir);
}

function criarIframeEImprimir(conteudoHTML) {
    var iframe = document.createElement("iframe");
    iframe.style.position = "absolute";
    iframe.style.width = "0";
    iframe.style.height = "0";
    iframe.style.border = "0";
    document.body.appendChild(iframe);

    var doc = iframe.contentWindow.document;
    doc.open();
    doc.write("<html><head><title>Imprimir</title>");
    document.querySelectorAll("link[rel='stylesheet'], style").forEach(function(el) {
        doc.write(el.outerHTML);
    });
    doc.write("</head><body>");
    doc.write(conteudoHTML);
    doc.write("</body></html>");
    doc.close();

    iframe.onload = function () {
        iframe.contentWindow.focus();
        iframe.contentWindow.print();
        setTimeout(function () {
            document.body.removeChild(iframe);
        }, 5000);
    };
}









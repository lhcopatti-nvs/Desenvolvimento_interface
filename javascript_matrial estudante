    const walker = document.createTreeWalker(
        intro,
        NodeFilter.SHOW_TEXT
    );

    let node;

    while (node = walker.nextNode()) {

        const texto = node.textContent.trim();

        if (
            texto.includes(
                'Parte II - Procedimentos Metodológicos'
            ) &&
            texto.includes(
                'Código de Ética Discente do CEUB'
            )
        ) {

            const wrapper =
                document.createElement('div');



            if (!parte2Existente) {

                const linkParte2 =
                    document.createElement('a');

                linkParte2.href =
                    'https://drive.google.com/file/d/1BTylbamCth0c9vH-xwLhrzImSMWX10B-/view?usp=sharing';

                linkParte2.target = '_blank';
                linkParte2.className = 'btn btn-primary';

                linkParte2.setAttribute(
                    'role',
                    'button'
                );

                /*
                 * Reaproveita o texto original.
                 */
                linkParte2.textContent =
                    'Parte II - Procedimentos Metodológicos';

                const divParte2 =
                    document.createElement('div');

                divParte2.className = 'my-3';

                divParte2.appendChild(
                    linkParte2
                );

                wrapper.appendChild(
                    divParte2
                );
            }



            if (!eticaExistente) {

                const linkEtica =
                    document.createElement('a');

                linkEtica.href =
                    'https://drive.google.com/file/d/1SJldGxcgo6EZkDjrQy_eMDV4ajZWDJHI/view?usp=sharing';

                linkEtica.target = '_blank';
                linkEtica.className = 'btn btn-primary';

                linkEtica.setAttribute(
                    'role',
